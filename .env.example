# ──────────────────────────────────────────────────────────────────
# Environment variable template — copy to .env.local and fill in
# ──────────────────────────────────────────────────────────────────
# NEVER commit .env.local — it is gitignored.

# Cesium Ion access token (required for the 3D globe)
# Create your free token at https://cesium.com/ion/tokens
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token_here
